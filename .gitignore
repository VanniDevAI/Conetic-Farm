# Never commit secrets
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# Never commit episode data (lives outside the repo; see docs/DESIGN.md)
# `episodes/` was meant to exclude a scratch directory. farm/episodes is
# the corpus of record and must be committed.
/episodes/
data/
logs/
runs/
*.bundle
*.diff
*.patch.out

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Local scratch
scratch/
tmp/
*.log

# The episode archive is evidence, not scratch. `*.diff` and `*.log` above are
# there to keep working files out of the repository, and they were silently
# eating the merged diffs and provider build logs an export had just written --
# an archive whose own FILES.json listed files that were not in the commit.
# Found by scripts/verify_export.py reading the remote tree rather than the disk.
!farm/episodes/artifacts/**
