# Conetic-Farm environment template.
# Copy to .env and fill in.  .env is git-ignored and MUST NEVER be committed.
#
# IMPORTANT: invoke the harness via `scripts/cooperbench`, not the bare
# `cooperbench` command.  CooperBench's own load_dotenv() walks up from its
# own cli.py, so it never reads this file; the wrapper injects these values
# into the child environment, where they win (load_dotenv uses
# override=False).  See docs/ENVIRONMENT.md section 1.
#
#   cp .env.example .env
#   chmod 600 .env
#
# Nothing in this repo ever echoes, logs, or serialises the value of a *_API_KEY
# variable.  Preflight only reports presence, length, and a SHA-256 prefix.

# ---------------------------------------------------------------------------
# Agent model credentials
# ---------------------------------------------------------------------------
# Primary: OpenRouter, used for the open-weight agent models (Qwen3-Coder etc.).
# LiteLLM (which CooperBench's mini_swe_agent_v2 adapter uses) reads exactly
# this variable name for any model string prefixed "openrouter/".
OPENROUTER_API_KEY=

# Optional: OpenRouter attribution headers (not secret).
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=conetic-farm

# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------
# LiteLLM-format model strings.  Agent A and agent B may be the same model.
FARM_MODEL_A=openrouter/qwen/qwen3-coder
FARM_MODEL_B=openrouter/qwen/qwen3-coder

# ---------------------------------------------------------------------------
# Budget (hard cap, enforced in farm/cost.py)
# ---------------------------------------------------------------------------
FARM_BUDGET_USD=50.00

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Episode data root.  MUST be outside this repository.
FARM_DATA_ROOT=/home/user/farm-data

# Path to the CooperBench checkout used as the harness.
FARM_COOPERBENCH_DIR=/home/user/work/CooperBench

# Redis for CooperBench coop-mode inter-agent messaging.
FARM_REDIS_URL=redis://127.0.0.1:6379
