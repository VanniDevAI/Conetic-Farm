+const { useForm } = require('./src/useForm');
+
+// Simulate the issue: when onValid throws, formState flags are left inconsistent
+async function testFormStateIssue() {
+  console.log('Testing form state consistency when onValid throws...');
+  
+  // This is a simplified version to demonstrate the issue
+  let formState = {
+    isSubmitting: false,
+    isSubmitted: false,
+    isSubmitSuccessful: false
+  };
+  
+  console.log('Initial form state:', formState);
+  
+  // Simulate handleSubmit setting isSubmitting to true
+  formState.isSubmitting = true;
+  console.log('After starting submission:', formState);
+  
+  try {
+    // Simulate onValid throwing an error
+    throw new Error('Server error occurred');
+  } catch (error) {
+    console.log('Error caught:', error.message);
+    // Currently, the form state is left inconsistent
+    console.log('Form state after error (INCONSISTENT):', formState);
+    
+    // What it should be after proper handling:
+    formState.isSubmitting = false;
+    formState.isSubmitted = true;
+    formState.isSubmitSuccessful = false;
+    console.log('Form state after proper handling:', formState);
+  }
+}
+
+testFormStateIssue();
