+// Test to verify the fix for form state consistency when onValid throws
+import { renderHook, act } from '@testing-library/react-hooks';
+import { useForm } from '../useForm';
+
+describe('handleSubmit form state consistency', () => {
+  it('should properly update form state flags when onValid throws an error', async () => {
+    const { result } = renderHook(() => useForm<{ test: string }>());
+
+    // Register a field
+    result.current.register('test');
+    
+    // Track form state changes
+    let formStateHistory: any[] = [];
+    const unsubscribe = result.current.control._subjects.state.subscribe({
+      next: (state) => {
+        formStateHistory.push({ ...state });
+      }
+    });
+
+    // Create an onValid function that throws
+    const onValid = jest.fn().mockImplementation(() => {
+      throw new Error('Server error');
+    });
+
+    // Call handleSubmit and expect it to throw
+    await expect(
+      act(async () => {
+        await result.current.handleSubmit(onValid)({
+          preventDefault: () => {},
+          persist: () => {},
+        } as any);
+      })
+    ).rejects.toThrow('Server error');
+
+    // Verify the form state history shows proper transitions
+    expect(formStateHistory).toHaveLength(3); // initial, isSubmitting=true, final state
+    
+    // First state change: isSubmitting should be true
+    expect(formStateHistory[0]).toMatchObject({
+      isSubmitting: true,
+    });
+    
+    // Final state change: form state should be consistent
+    const finalState = formStateHistory[1];
+    expect(finalState).toMatchObject({
+      isSubmitted: true,
+      isSubmitting: false,
+      isSubmitSuccessful: false,
+    });
+    
+    unsubscribe();
+  });
+});
