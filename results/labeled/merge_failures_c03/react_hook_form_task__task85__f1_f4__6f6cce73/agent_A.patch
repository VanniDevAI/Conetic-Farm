+// Test script to verify the fix for async defaultValues in React.StrictMode
+
+// Mock the control state and functions
+let mockState = {
+  isResetDefaultValuesExecuted: false
+};
+
+let callCount = 0;
+let results = [];
+
+// Mock options with async defaultValues function
+const mockOptions = {
+  defaultValues: async () => {
+    const callId = ++callCount;
+    console.log(`Executing async defaultValues - call ${callId}`);
+    
+    // Simulate async operation
+    return new Promise(resolve => {
+      setTimeout(() => {
+        console.log(`Resolving async defaultValues - call ${callId}`);
+        resolve({ test: `value_${callId}` });
+      }, callId === 1 ? 200 : 100); // First call takes longer
+    });
+  }
+};
+
+// Mock reset function
+const mockReset = (values) => {
+  console.log('Reset called with values:', values);
+  results.push(values);
+};
+
+// Mock subjects
+const mockSubjects = {
+  state: {
+    next: (state) => console.log('State update:', state)
+  }
+};
+
+// Fixed _resetDefaultValues function
+const _resetDefaultValues = () => {
+  const isFunction = (fn) => typeof fn === 'function';
+  
+  if (isFunction(mockOptions.defaultValues)) {
+    if (!mockState.isResetDefaultValuesExecuted) {
+      mockState.isResetDefaultValuesExecuted = true;
+      console.log('Flag set to prevent subsequent executions');
+      
+      mockOptions.defaultValues().then((values) => {
+        mockReset(values);
+        mockSubjects.state.next({
+          isLoading: false,
+        });
+      });
+    } else {
+      console.log('Skipping execution - async defaultValues already requested');
+    }
+  }
+};
+
+// Test the fix
+console.log('Testing the fix for async defaultValues in React.StrictMode...\n');
+
+console.log('First call to _resetDefaultValues:');
+_resetDefaultValues();
+
+console.log('\nSecond call to _resetDefaultValues (simulating StrictMode double execution):');
+_resetDefaultValues();
+
+// Wait for promises to resolve
+setTimeout(() => {
+  console.log('\nTest completed.');
+  console.log('Number of actual executions:', results.length);
+  console.log('Results:', results);
+  
+  if (results.length === 1) {
+    console.log('✅ SUCCESS: Async defaultValues was executed only once!');
+  } else {
+    console.log('❌ FAILURE: Async defaultValues was executed multiple times.');
+  }
+}, 500);
