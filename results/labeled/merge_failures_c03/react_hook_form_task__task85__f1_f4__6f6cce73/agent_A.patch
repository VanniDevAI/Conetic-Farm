--- /dev/null
+++ b/reproduce_issue.js
@@ -0,0 +1,50 @@
+// Simple reproduction script for the async defaultValues issue in React.StrictMode
+console.log("Reproducing async defaultValues issue in React.StrictMode...");
+
+// Simulate the problematic scenario
+let callCount = 0;
+let resolveOrder = [];
+
+const asyncDefaultValues = async () => {
+  const callId = ++callCount;
+  console.log(`Calling async defaultValues function - call ${callId}`);
+  
+  // Simulate different resolution times
+  const delay = callId === 1 ? 200 : 100; // First call takes longer
+  
+  return new Promise(resolve => {
+    setTimeout(() => {
+      resolveOrder.push(callId);
+      console.log(`Resolving call ${callId} (delay: ${delay}ms)`);
+      resolve({ test: `value_from_call_${callId}` });
+    }, delay);
+  });
+};
+
+// Simulate the double execution in React.StrictMode
+console.log("Simulating double execution...");
+
+const results = [];
+asyncDefaultValues().then(result => {
+  results.push({call: 1, result});
+  console.log("First call result:", result);
+});
+
+asyncDefaultValues().then(result => {
+  results.push({call: 2, result});
+  console.log("Second call result:", result);
+  
+  // Show the order of resolution
+  console.log("Resolution order:", resolveOrder);
+  
+  // The issue: later resolving call overwrites the form values
+  console.log("Issue: Call", resolveOrder[resolveOrder.length-1], "will overwrite the form values!");
+});
+
+setTimeout(() => {
+  console.log("\nThis demonstrates the problem:");
+  console.log("- async defaultValues function is called twice");
+  console.log("- Second call resolves first (faster)");
+  console.log("- First call resolves later (slower) and overwrites the form values");
+  console.log("- This leads to unpredictable form states");
+}, 300);
