+import json
+from dspy.adapters.types.tool import ToolCalls
+
+def test_code_fence_extraction():
+    # Test case 1: JSON with code fences
+    input_data = '''```json
+{"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+```'''
+    
+    # This should extract and parse the JSON
+    result = ToolCalls.validate_input(input_data)
+    print("Test 1 - Code fence extraction:")
+    print(f"Input: {input_data}")
+    print(f"Result: {result}")
+    print()
+    
+    # Test case 2: JSON with uppercase JSON label
+    input_data2 = '''```JSON
+[{"name": "search", "args": {"q": "stanford"}}]
+```'''
+    
+    result2 = ToolCalls.validate_input(input_data2)
+    print("Test 2 - Uppercase JSON label:")
+    print(f"Input: {input_data2}")
+    print(f"Result: {result2}")
+    print()
+    
+    # Test case 3: JSON without language label
+    input_data3 = '''```
+{"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+```'''
+    
+    result3 = ToolCalls.validate_input(input_data3)
+    print("Test 3 - No language label:")
+    print(f"Input: {input_data3}")
+    print(f"Result: {result3}")
+    print()
+    
+    # Test case 4: Regular string (no fences)
+    input_data4 = '{"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}'
+    
+    result4 = ToolCalls.validate_input(input_data4)
+    print("Test 4 - Regular JSON string (no fences):")
+    print(f"Input: {input_data4}")
+    print(f"Result: {result4}")
+    print()
+    
+    # Test case 5: Invalid JSON in fences (should fall back)
+    input_data5 = '''```json
+{"tool_calls": [{"name": "search", "args": {invalid json}}]}
+```'''
+    
+    result5 = ToolCalls.validate_input(input_data5)
+    print("Test 5 - Invalid JSON in fences (should fall back):")
+    print(f"Input: {input_data5}")
+    print(f"Result: {result5}")
+    print()
+
+if __name__ == "__main__":
+    test_code_fence_extraction()
