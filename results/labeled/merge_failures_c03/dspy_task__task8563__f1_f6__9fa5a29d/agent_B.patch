+
+        This method detects when a string input contains a code-fenced block (e.g., ```json ... ```),
+        extracts the inner content, and attempts to parse it as JSON before normal validation.
+        """
+        if isinstance(data, str):
+            # Check if the string contains code fences
+            fence_pattern = r"```(?:json|JSON)?\s*(.*?)```"
+            match = re.search(fence_pattern, data, re.DOTALL)
+            
+            if match:
+                # Extract the content between the fences
+                extracted_content = match.group(1).strip()
+                
+                # Try to parse as JSON
+                try:
+                    parsed_data = json.loads(extracted_content)
+                    return parsed_data
+                except json.JSONDecodeError:
+                    # If JSON parsing fails, fall back to original string handling
+                    pass
+        
+        # For non-string data or if extraction/parsing failed, return as-is
+        return data
