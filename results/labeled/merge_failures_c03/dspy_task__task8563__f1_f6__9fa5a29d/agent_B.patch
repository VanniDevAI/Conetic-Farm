+import pytest
+from dspy.adapters.types.tool import ToolCalls
+
+def test_toolcalls_code_fence_extraction():
+    """Test that ToolCalls.validate_input correctly extracts JSON from code fences."""
+    
+    # Test case 1: JSON with code fences
+    input_data = '''```json
+{"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+```'''
+    
+    # This should extract and parse the JSON
+    result = ToolCalls.validate_input(input_data)
+    expected = {"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+    assert result == expected
+    
+    # Test case 2: JSON with uppercase JSON label
+    input_data2 = '''```JSON
+[{"name": "search", "args": {"q": "stanford"}}]
+```'''
+    
+    result2 = ToolCalls.validate_input(input_data2)
+    expected2 = [{"name": "search", "args": {"q": "stanford"}}]
+    assert result2 == expected2
+    
+    # Test case 3: JSON without language label
+    input_data3 = '''```
+{"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+```'''
+    
+    result3 = ToolCalls.validate_input(input_data3)
+    expected3 = {"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+    assert result3 == expected3
+    
+    # Test case 4: Regular string (no fences) - should remain unchanged
+    input_data4 = '{"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}'
+    
+    result4 = ToolCalls.validate_input(input_data4)
+    assert result4 == input_data4  # Should remain as string
+    
+    # Test case 5: Invalid JSON in fences (should fall back)
+    input_data5 = '''```json
+{"tool_calls": [{"name": "search", "args": {invalid json}}]}
+```'''
+    
+    result5 = ToolCalls.validate_input(input_data5)
+    assert result5 == input_data5  # Should remain as original string
+    
+    # Test case 6: Non-string input should remain unchanged
+    input_data6 = {"tool_calls": [{"name": "search", "args": {"q": "stanford"}}]}
+    
+    result6 = ToolCalls.validate_input(input_data6)
+    assert result6 == input_data6  # Should remain as dict
+
+def test_toolcalls_integration():
+    """Test that the extracted data works with ToolCalls instantiation."""
+    
+    # Test with code-fenced JSON that represents a list of tool calls
+    input_data = '''```json
+[{"name": "search", "args": {"q": "stanford"}}, {"name": "translate", "args": {"text": "hello"}}]
+```'''
+    
+    # Extract the data
+    extracted_data = ToolCalls.validate_input(input_data)
+    
+    # Create ToolCalls instance from the extracted data
+    tool_calls = ToolCalls.from_dict_list(extracted_data)
+    
+    # Verify it works correctly
+    assert len(tool_calls.tool_calls) == 2
+    assert tool_calls.tool_calls[0].name == "search"
+    assert tool_calls.tool_calls[0].args == {"q": "stanford"}
+    assert tool_calls.tool_calls[1].name == "translate"
+    assert tool_calls.tool_calls[1].args == {"text": "hello"}
+
+if __name__ == "__main__":
+    test_toolcalls_code_fence_extraction()
+    test_toolcalls_integration()
+    print("All tests passed!")
