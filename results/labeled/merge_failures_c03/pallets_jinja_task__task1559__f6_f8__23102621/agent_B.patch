+import pytest
+from jinja2 import Environment, DictLoader
+from jinja2.ext import conditional_i18n
+
+
+# Mock gettext functions for testing
+def mock_gettext(message):
+    # Simple mock that prefixes "translated:" to show it's working
+    return f"translated:{message}"
+
+def mock_ngettext(singular, plural, n):
+    if n == 1:
+        return f"translated:{singular}"
+    else:
+        return f"translated:{plural}"
+
+
+def test_conditional_translation_basic():
+    """Test basic conditional translation with true condition"""
+    env = Environment(extensions=[conditional_i18n])
+    env.globals.update({
+        "gettext": mock_gettext,
+        "ngettext": mock_ngettext,
+    })
+    
+    # Test with true condition
+    template = env.from_string('{% ctrans True %}Hello World{% fallback %}Fallback text{% endctrans %}')
+    result = template.render()
+    # Should use translation
+    assert result == "translated:Hello World"
+
+
+def test_conditional_translation_false_condition():
+    """Test conditional translation with false condition"""
+    env = Environment(extensions=[conditional_i18n])
+    env.globals.update({
+        "gettext": mock_gettext,
+        "ngettext": mock_ngettext,
+    })
+    
+    # Test with false condition
+    template = env.from_string('{% ctrans False %}Hello World{% fallback %}Fallback text{% endctrans %}')
+    result = template.render()
+    # Should use fallback
+    assert result == "Fallback text"
+
+
+def test_conditional_translation_with_variables():
+    """Test conditional translation with variables"""
+    env = Environment(extensions=[conditional_i18n])
+    env.globals.update({
+        "gettext": mock_gettext,
+        "ngettext": mock_ngettext,
+    })
+    
+    # Test with variables
+    template = env.from_string('{% ctrans True name="John" %}Hello {{ name }}{% fallback %}Fallback {{ name }}{% endctrans %}')
+    result = template.render()
+    # Should use translation with variable
+    assert result == "translated:Hello {{ name }}"  # Note: variables are processed differently based on newstyle
+
+
+def test_conditional_translation_plural():
+    """Test conditional translation with plural forms"""
+    env = Environment(extensions=[conditional_i18n])
+    env.globals.update({
+        "gettext": mock_gettext,
+        "ngettext": mock_ngettext,
+    })
+    
+    # Test with plural
+    template = env.from_string('{% ctrans True count=1 %}{{ count }} item{% pluralize count %}{{ count }} items{% fallback %}Fallback{% endctrans %}')
+    result = template.render()
+    # Should use translation
+    assert "translated:" in result
+
+
+def test_syntax_error_missing_fallback():
+    """Test that missing fallback block raises error"""
+    env = Environment(extensions=[conditional_i18n])
+    env.globals.update({
+        "gettext": mock_gettext,
+        "ngettext": mock_ngettext,
+    })
+    
+    # Should raise TemplateSyntaxError
+    with pytest.raises(Exception):  # Using generic Exception since we don't have access to the specific exception
+        env.from_string('{% ctrans True %}Hello World{% endctrans %}')
+
+
+def test_conditional_translation_with_expressions():
+    """Test conditional translation with expressions as condition"""
+    env = Environment(extensions=[conditional_i18n])
+    env.globals.update({
+        "gettext": mock_gettext,
+        "ngettext": mock_ngettext,
+    })
+    
+    # Test with expression condition
+    template = env.from_string('{% ctrans 1 == 1 %}True case{% fallback %}False case{% endctrans %}')
+    result = template.render()
+    # Should use translation
+    assert result == "translated:True case"
+
+
+if __name__ == "__main__":
+    test_conditional_translation_basic()
+    test_conditional_translation_false_condition()
+    test_conditional_translation_with_variables()
+    test_conditional_translation_plural()
+    test_syntax_error_missing_fallback()
+    test_conditional_translation_with_expressions()
+    print("All tests passed!")
