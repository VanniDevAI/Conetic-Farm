+// Draft implementation for pattern matching in str.first() and str.last()
+
+// First, I'll need an enum for the character classes
+enum CharClass {
+    Alpha,
+    Numeric,
+    Alphanumeric,
+    Uppercase,
+    Lowercase,
+    Whitespace,
+}
+
+// Function to parse the pattern string into a CharClass
+fn parse_char_class(pattern: &str) -> Result<CharClass, EcoString> {
+    match pattern {
+        "alpha" => Ok(CharClass::Alpha),
+        "numeric" => Ok(CharClass::Numeric),
+        "alphanumeric" => Ok(CharClass::Alphanumeric),
+        "uppercase" => Ok(CharClass::Uppercase),
+        "lowercase" => Ok(CharClass::Lowercase),
+        "whitespace" => Ok(CharClass::Whitespace),
+        _ => Err(format!("unknown pattern \"{}\"", pattern).into()),
+    }
+}
+
+// Function to check if a character matches a character class
+fn char_matches_class(c: char, class: &CharClass) -> bool {
+    match class {
+        CharClass::Alpha => c.is_alphabetic(),
+        CharClass::Numeric => c.is_numeric(),
+        CharClass::Alphanumeric => c.is_alphanumeric(),
+        CharClass::Uppercase => c.is_uppercase(),
+        CharClass::Lowercase => c.is_lowercase(),
+        CharClass::Whitespace => c.is_whitespace(),
+    }
+}
+
+// Example of how the first() method might look with pattern support:
+/*
+pub fn first(&self, #[named] pattern: Option<Str>) -> StrResult<Str> {
+    if let Some(pattern_str) = pattern {
+        let char_class = parse_char_class(pattern_str.as_str())?;
+        for grapheme in self.0.graphemes(true) {
+            if let Some(first_char) = grapheme.chars().next() {
+                if char_matches_class(first_char, &char_class) {
+                    return Ok(grapheme.into());
+                }
+            }
+        }
+        // No matching character found
+        return Err(format!("no character matches pattern \"{}\"", pattern_str).into());
+    }
+    
+    // Original behavior when no pattern is provided
+    self.0
+        .graphemes(true)
+        .next()
+        .map(Into::into)
+        .ok_or_else(string_is_empty)
+}
+*/
