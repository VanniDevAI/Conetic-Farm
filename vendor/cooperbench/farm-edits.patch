+    # [conetic-farm] The sandbox's working tree, for a solo lane that never published.
+    def working_tree_patch(self, env: DockerEnvironment) -> str:
+        """The container's working tree as a diff against the task's base commit.
+
+        ``submitted_patch`` grades only what an agent PUBLISHED, so a colleague could read
+        it. In coop that rule is the whole point. In a solo lane there is no colleague and
+        no channel, so the same rule grades submission etiquette instead of work: a lane
+        that wrote the feature, ran the suite green and then narrated a summary rather than
+        running ``git commit`` submits nothing at all.
+
+        Measured, twice, in one six-lane run: both lanes of ``c06-pair1-roomed`` finished
+        with ``npx vitest run`` green and ``npx tsc --noEmit`` clean, ran zero git commands
+        across 68 and 20 steps, and were recorded as having produced nothing. The episode
+        graded as an empty set while two working implementations sat in its containers.
+
+        ``git add -A`` first, so a new router in a new file counts. The index is dirtied,
+        which does not matter: the container is about to be destroyed.
+        """
+        if not self._base_sha:
+            return ""
+        # `patch.txt` is the submission protocol's own artifact, not the agent's
+        # work. Sweeping it in would put a copy of the diff inside the diff.
+        self._exec(env, "git add -A && git reset -q -- patch.txt 2>/dev/null; true")
+        result = self._exec(env, f"git --no-pager diff --binary {self._base_sha}")
+        return result.get("output", "") or ""
+
