+const { PrismaClient } = require('@prisma/client');
+const prisma = new PrismaClient();
+
+async function main() {
+  const posts = await prisma.post.findMany({
+    select: {
+      id: true,
+      title: true,
+      author: true
+    }
+  });
+  console.log('Posts in database:');
+  console.table(posts);
+}
+
+main()
+  .catch(e => console.error(e))
+  .finally(async () => {
+    await prisma.$disconnect();
+  });
