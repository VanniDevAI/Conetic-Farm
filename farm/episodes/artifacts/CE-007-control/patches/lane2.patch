+/**
+ * Test for date range filtering feature
+ */
+import type { inferProcedureInput } from '@trpc/server';
+import { createContextInner } from '../context';
+import type { AppRouter } from './_app';
+import { createCaller } from './_app';
+
+describe('date range filtering', () => {
+  test('filter posts by date range', async () => {
+    const ctx = await createContextInner({});
+    const caller = createCaller(ctx);
+
+    // Test without date filters (should work as before)
+    const allPosts = await caller.post.list({ limit: 10 });
+    expect(allPosts).toHaveProperty('items');
+    expect(allPosts).toHaveProperty('nextCursor');
+    
+    // Test with from date only
+    const postsFromYesterday = await caller.post.list({ 
+      limit: 10, 
+      fromDate: new Date(Date.now() - 24 * 60 * 60 * 1000)
+    });
+    expect(postsFromYesterday).toHaveProperty('items');
+    
+    // Test with to date only
+    const postsToTomorrow = await caller.post.list({ 
+      limit: 10, 
+      toDate: new Date(Date.now() + 24 * 60 * 60 * 1000)
+    });
+    expect(postsToTomorrow).toHaveProperty('items');
+    
+    // Test with both from and to dates
+    const postsInRange = await caller.post.list({ 
+      limit: 10, 
+      fromDate: new Date(Date.now() - 2 * 24 * 60 * 60 * 1000),
+      toDate: new Date(Date.now() + 24 * 60 * 60 * 1000)
+    });
+    expect(postsInRange).toHaveProperty('items');
+  });
+});
