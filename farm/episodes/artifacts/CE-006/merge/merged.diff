diff --git a/test_author_posts.ts b/test_author_posts.ts
new file mode 100644
index 0000000..7819c79
--- /dev/null
+++ b/test_author_posts.ts
@@ -0,0 +1,48 @@
+import { PrismaClient } from '@prisma/client';
+
+const prisma = new PrismaClient();
+
+async function main() {
+  console.log('Testing author-based post queries...');
+  
+  // Get all authors
+  const authors = await prisma.author.findMany();
+  console.log('Authors:', authors);
+  
+  // Get posts for the first author
+  const defaultAuthor = authors[0];
+  console.log('\nPosts by author:', defaultAuthor.name);
+  const postsByAuthor = await prisma.post.findMany({
+    where: {
+      authorId: defaultAuthor.id
+    },
+    orderBy: {
+      createdAt: 'desc'
+    }
+  });
+  console.log(postsByAuthor);
+  
+  // Get posts for the second author
+  if (authors.length > 1) {
+    const secondAuthor = authors[1];
+    console.log('\nPosts by author:', secondAuthor.name);
+    const postsBySecondAuthor = await prisma.post.findMany({
+      where: {
+        authorId: secondAuthor.id
+      },
+      orderBy: {
+        createdAt: 'desc'
+      }
+    });
+    console.log(postsBySecondAuthor);
+  }
+}
+
+main()
+  .catch((e) => {
+    console.error(e);
+    process.exit(1);
+  })
+  .finally(async () => {
+    await prisma.$disconnect();
+  });
