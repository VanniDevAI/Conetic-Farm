+
+test('get posts by author', async () => {
+  const ctx = await createContextInner({});
+  const caller = createCaller(ctx);
+
+  // Use unique author IDs for this test to avoid conflicts
+  const testAuthor1 = `author-1-${Date.now()}`;
+  const testAuthor2 = `author-2-${Date.now()}`;
+
+  // Add posts with different authors
+  const post1 = await caller.post.add({
+    title: 'Post by Author 1',
+    text: 'Content by author 1',
+    authorId: testAuthor1,
+  });
+
+  const post2 = await caller.post.add({
+    title: 'Another Post by Author 1',
+    text: 'More content by author 1',
+    authorId: testAuthor1,
+  });
+
+  const post3 = await caller.post.add({
+    title: 'Post by Author 2',
+    text: 'Content by author 2',
+    authorId: testAuthor2,
+  });
+
+  // Get posts by author 1
+  const author1Posts = await caller.post.byAuthor({
+    authorId: testAuthor1,
+    limit: 10,
+  });
+
+  // Should have 2 posts
+  expect(author1Posts.items).toHaveLength(2);
+  
+  // Should only contain posts by testAuthor1
+  expect(author1Posts.items.every(post => post.authorId === testAuthor1)).toBe(true);
+  
+  // Should be ordered by newest first
+  expect(author1Posts.items[0].title).toBe('Another Post by Author 1');
+  
+  // Get posts by author 2
+  const author2Posts = await caller.post.byAuthor({
+    authorId: testAuthor2,
+    limit: 10,
+  });
+
+  // Should have 1 post
+  expect(author2Posts.items).toHaveLength(1);
+  
+  // Should only contain posts by testAuthor2
+  expect(author2Posts.items[0].authorId).toBe(testAuthor2);
+});
+
+test('pagination for posts by author', async () => {
+  const ctx = await createContextInner({});
+  const caller = createCaller(ctx);
+
+  // Use a unique author ID for this test
+  const testAuthor = `pagination-test-author-${Date.now()}`;
+
+  // Add multiple posts for the same author
+  for (let i = 1; i <= 5; i++) {
+    await caller.post.add({
+      title: `Post ${i}`,
+      text: `Content ${i}`,
+      authorId: testAuthor,
+    });
+  }
+
+  // Get first page
+  const firstPage = await caller.post.byAuthor({
+    authorId: testAuthor,
+    limit: 2,
+  });
+
+  expect(firstPage.items).toHaveLength(2);
+  expect(firstPage.nextCursor).toBeDefined();
+
+  // Get second page using cursor
+  const secondPage = await caller.post.byAuthor({
+    authorId: testAuthor,
+    limit: 2,
+    cursor: firstPage.nextCursor,
+  });
+
+  expect(secondPage.items).toHaveLength(2);
+  expect(secondPage.nextCursor).toBeDefined();
+
+  // Get third page
+  const thirdPage = await caller.post.byAuthor({
+    authorId: testAuthor,
+    limit: 2,
+    cursor: secondPage.nextCursor,
+  });
+
+  expect(thirdPage.items).toHaveLength(1); // Last page should have 1 item
+  expect(thirdPage.nextCursor).toBeUndefined(); // No more pages
+});
