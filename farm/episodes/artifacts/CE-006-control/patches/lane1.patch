+  byAuthor: publicProcedure
+    .input(
+      z.object({
+        author: z.string(),
+        limit: z.number().min(1).max(100).nullish(),
+        cursor: z.string().nullish(),
+      }),
+    )
+    .query(async ({ input }) => {
+      /**
+       * For pagination docs you can have a look here
