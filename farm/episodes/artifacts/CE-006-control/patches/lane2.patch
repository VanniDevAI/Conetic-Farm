+test('get posts by date range', async () => {
+  const ctx = await createContextInner({});
+  const caller = createCaller(ctx);
+
+  // Clear existing posts to have a clean test environment
+  // In a real test environment, we'd use a test database
+  
+  // Add some test posts
+  const now = new Date();
+  
+  // Add a few posts with the current timestamp
+  const post1 = await caller.post.add({
+    title: 'Recent post 1',
+    text: 'This is a recent post',
+  });
+  
+  const post2 = await caller.post.add({
+    title: 'Recent post 2',
+    text: 'This is another recent post',
+  });
+  
+  const post3 = await caller.post.add({
+    title: 'Recent post 3',
+    text: 'This is yet another recent post',
+  });
+  
+  // Test getting posts with no date range (should get all posts)
+  const resultAll = await caller.post.listByDateRange({});
+  expect(resultAll.items).toBeDefined();
+  expect(Array.isArray(resultAll.items)).toBe(true);
+  expect(resultAll.items.length).toBeGreaterThanOrEqual(3);
+  
+  // Test getting posts with a narrow date range (should get some posts)
+  const resultRecent = await caller.post.listByDateRange({
+    startDate: new Date(now.getTime() - 1000), // A second ago
+    endDate: new Date(now.getTime() + 1000),   // In a second
+  });
+  expect(resultRecent.items).toBeDefined();
+  expect(Array.isArray(resultRecent.items)).toBe(true);
+});
