+const { execSync } = require('child_process');
+
+// Run a simple integration test to make sure the new endpoint is properly exposed
+console.log("Testing integration...");
+
+// Check that our new procedure is properly exported in the router
+const fs = require('fs');
+const routerContent = fs.readFileSync('src/server/routers/post.ts', 'utf8');
+
+if (routerContent.includes('listByDateRange')) {
+  console.log("✅ New procedure 'listByDateRange' found in post router");
+} else {
+  console.error("❌ New procedure 'listByDateRange' not found in post router");
+  process.exit(1);
+}
+
+// Check that the router is properly registered in the app
+const appRouterContent = fs.readFileSync('src/server/routers/_app.ts', 'utf8');
+
+if (appRouterContent.includes('post: postRouter')) {
+  console.log("✅ Post router is properly registered in app router");
+} else {
+  console.error("❌ Post router is not properly registered in app router");
+  process.exit(1);
+}
+
+console.log("✅ Integration test passed");
