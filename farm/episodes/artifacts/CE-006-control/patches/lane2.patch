@@ -0,0 +1,54 @@
+const { execSync } = require('child_process');
+
+// Run comprehensive tests for the new date range feature
+console.log("Running comprehensive tests for date range feature...");
+
+// Test 1: TypeScript compilation
+console.log("\n1. Testing TypeScript compilation...");
+try {
+  execSync('npx tsc --noEmit', { stdio: 'inherit' });
+  console.log("✅ TypeScript compilation successful");
+} catch (error) {
+  console.error("❌ TypeScript compilation failed");
+  process.exit(1);
+}
+
+// Test 2: Unit tests
+console.log("\n2. Running unit tests...");
+try {
+  execSync('npx vitest run', { stdio: 'inherit' });
+  console.log("✅ Unit tests passed");
+} catch (error) {
+  console.error("❌ Unit tests failed");
+  process.exit(1);
+}
+
+// Test 3: Check for proper exports
+console.log("\n3. Checking proper exports...");
+const fs = require('fs');
+const routerContent = fs.readFileSync('src/server/routers/post.ts', 'utf8');
+
+const checks = [
+  { name: 'listByDateRange procedure', pattern: 'listByDateRange:' },
+  { name: 'startDate input validation', pattern: 'startDate: z.date().nullish()' },
+  { name: 'endDate input validation', pattern: 'endDate: z.date().nullish()' },
+  { name: 'limit parameter', pattern: 'limit: z.number().min(1).max(100).nullish()' },
+  { name: 'cursor parameter', pattern: 'cursor: z.string().nullish()' },
+  { name: 'orderBy createdAt desc', pattern: "orderBy: {\n          createdAt: 'desc',\n        }" }
+];
+
+let allChecksPassed = true;
+for (const check of checks) {
+  if (routerContent.includes(check.pattern)) {
+    console.log(`✅ ${check.name}`);
+  } else {
+    console.error(`❌ ${check.name} not found`);
+    allChecksPassed = false;
+  }
+}
+
+if (!allChecksPassed) {
+  process.exit(1);
+}
+
+console.log("\n✅ All comprehensive tests passed!");
