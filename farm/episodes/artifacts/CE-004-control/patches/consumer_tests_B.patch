+import { QueryClient } from '@tanstack/query-core'
+import { describe, expect, it } from 'vitest'
+
+import { countStale } from './digest.js'
+
+function clientWith(ages: Array<number>): QueryClient {
+  const client = new QueryClient()
+  const cache = client.getQueryCache()
+  ages.forEach((age, i) => {
+    const query = cache.build(client, { queryKey: ['q', i], queryFn: async () => i })
+    query.setData(i, { updatedAt: Date.now() - age })
+  })
+  return client
+}
+
+describe('countStale', () => {
+  it('counts nothing when everything is fresh', () => {
+    expect(countStale(clientWith([0, 0]), 60_000)).toBe(0)
+  })
+
+  it('counts the queries whose data is older than staleTime', () => {
+    expect(countStale(clientWith([60_000, 60_000, 0]), 1_000)).toBe(2)
+  })
+
+  it('counts everything at the default staleTime of zero', () => {
+    expect(countStale(clientWith([5_000, 5_000]))).toBe(2)
+  })
+})
