          "{venv}/bin/pip install -q 'pytest<8' pytest-xdist pytest_mock"
        ]
      },
      {
        "name": "pytest-6",
        "setup_commands": [
          "test -x {venv}/bin/python || python3 -m venv {venv}",
          "{venv}/bin/pip install -q --upgrade pip",
