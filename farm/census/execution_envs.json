{
  "pallets_jinja_task": {
    "url": "https://github.com/pallets/jinja.git",
    "setup_variants": [
      {
        "name": "pytest-current",
        "setup_commands": [
          "test -x {venv}/bin/python || python3 -m venv {venv}",
          "{venv}/bin/pip install -q --upgrade pip",
          "{venv}/bin/pip install -q -e '.[test]' || {venv}/bin/pip install -q -e .",
          "{venv}/bin/pip install -q pytest pytest-xdist pytest_mock"
        ]
      },
      {
        "name": "pytest-7",
        "setup_commands": [
          "test -x {venv}/bin/python || python3 -m venv {venv}",
