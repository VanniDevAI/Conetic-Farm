diff --git a/src/hints.ts b/src/hints.ts
index 786c2e9..5ba711e 100644
--- a/src/hints.ts
+++ b/src/hints.ts
@@ -20,3 +20,22 @@ export function describeMultipleOf(value: number, step: number): string {
     ? `${value} is a multiple of ${step}`
     : `${value} is not a multiple of ${step}`
 }
+
+/**
+ * The multiple of `step` closest to `value`.
+ */
+export function nearestMultiple(value: number, step: number): number {
+  return Math.round(value / step) * step
+}
+
+/**
+ * What a form field should show for `value` against a `multipleOf(step)` rule.
+ */
+export function hintFor(
+  value: number,
+  step: number,
+): { ok: boolean; nearest: number; offBy: number } {
+  const ok = isMultipleOf(value, step)
+  const nearest = nearestMultiple(value, step)
+  return { ok, nearest, offBy: ok ? 0 : Math.abs(value - nearest) }
+}
