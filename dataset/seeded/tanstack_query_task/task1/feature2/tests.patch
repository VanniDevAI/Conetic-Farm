+
+describe('getStalenessReport', () => {
+  let client: QueryClient
+
+  beforeEach(() => {
+    vi.useFakeTimers()
+    client = new QueryClient()
+    client.mount()
+  })
+
+  afterEach(() => {
+    client.clear()
+    vi.useRealTimers()
+  })
+
+  it('reports data older than the staleTime as stale', async () => {
+    const key = queryKey()
+    await client.fetchQuery({ queryKey: key, queryFn: () => Promise.resolve('x') })
+    const query = client.getQueryCache().find({ queryKey: key })!
+
+    await vi.advanceTimersByTimeAsync(10_000)
+
+    const report = query.getStalenessReport(1_000)
+    expect(report.hasData).toBe(true)
+    expect(report.isStale).toBe(true)
+  })
+
+  it('reports data inside the staleTime as fresh', async () => {
+    const key = queryKey()
+    await client.fetchQuery({ queryKey: key, queryFn: () => Promise.resolve('x') })
+    const query = client.getQueryCache().find({ queryKey: key })!
+
+    const report = query.getStalenessReport(60_000)
+    expect(report.isStale).toBe(false)
+    expect(report.dataUpdatedAt).toBeGreaterThan(0)
+  })
+})
