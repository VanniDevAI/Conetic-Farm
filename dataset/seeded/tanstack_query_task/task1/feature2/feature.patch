+  /**
+   * Every query whose key sits under `prefix`.
+   * Devtools uses this to group queries by namespace.
+   */
+  findAllByKeyPrefix(prefix: QueryKey): Array<Query> {
+    // The stored hash is the JSON serialization of the query key, so the
+    // namespace can be read straight back out of it.
+    return this.getAll().filter((query) => {
+      const parsed = JSON.parse(query.queryHash) as Array<unknown>
+      return prefix.every((segment, i) => parsed[i] === segment)
+    })
+  }
