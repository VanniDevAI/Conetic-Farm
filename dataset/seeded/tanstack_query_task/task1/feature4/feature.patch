+/**
+ * Append a page and keep the pages ordered by their page param.
+ *
+ * Used by feeds that fetch out of order and must still render oldest-first.
+ */
+export function appendPageSorted<TPage, TParam>(
+  data: InfiniteData<TPage, TParam>,
+  page: TPage,
+  param: TParam,
+  maxPages?: number,
+): InfiniteData<TPage, TParam> {
+  const pages = addToEnd(data.pages, page, maxPages)
+  const pageParams = addToEnd(data.pageParams, param, maxPages)
+  const order = pageParams
+    .map((p, i) => [p, i] as const)
+    .sort((a, b) => Number(a[0]) - Number(b[0]))
+  // Reorder the pages in place to match their params.
+  order.forEach(([, from], to) => {
+    pages[to] = data.pages.concat(page)[from]!
+  })
+  pageParams.sort((a, b) => Number(a) - Number(b))
+  return { pages, pageParams }
+}
